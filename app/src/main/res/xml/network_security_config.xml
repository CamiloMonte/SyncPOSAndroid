<?xml version="1.0" encoding="utf-8"?>
<!--
  Por defecto Android bloquea el trafico http (sin cifrar). En desarrollo el servidor
  Laravel corre en http://, asi que se permite SOLO para 10.0.2.2 (el computador visto
  desde el emulador) y 127.0.0.1. Cualquier otro dominio sigue exigiendo https.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
